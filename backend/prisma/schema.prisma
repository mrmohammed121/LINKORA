generator client {
  provider = "prisma-client-js"
}

// Structured cleanly so switching to PostgreSQL later takes 1 line:
// change provider to "postgresql" and point DATABASE_URL to Neon/Supabase.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime @default(now())
  links        Link[]
}

model Link {
  id             String       @id @default(uuid())
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  guestSessionId String?
  originalUrl    String
  slug           String       @unique
  status         String       @default("ACTIVE") // "ACTIVE" | "EXPIRED" | "DISABLED"
  isGuest        Boolean      @default(false)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  clicks         ClickEvent[]

  @@index([ownerId])
  @@index([guestSessionId])
  @@index([isGuest])
}

model ClickEvent {
  id           String   @id @default(uuid())
  linkId       String
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt    DateTime @default(now())
  referrer     String   @default("Direct")
  deviceType   String   // "Mobile" | "Desktop" | "Tablet" | "Bot"
  region       String   @default("Local/Unknown")
  anonymisedIp String

  @@index([linkId, clickedAt])
}
