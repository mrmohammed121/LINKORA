# Neon PostgreSQL connection strings
# Pooled connection string (used at runtime by Prisma Client)
DATABASE_URL="postgresql://USER:PASSWORD@EP-POOLER.REGION.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"
# Direct (unpooled) connection string (used by Prisma CLI migrations / db push)
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Centralized Public Base URL used for all generated short links and QR codes
# Development: http://localhost:4000
# Production:  https://your-actual-domain.com (set in deployment environment)
PUBLIC_BASE_URL=http://localhost:4000

# Frontend URL used for CORS and QR Rescue fallback redirects (/rescue/:slug)
# Production: set to your deployed frontend URL (and optional comma-separated CORS_ORIGINS)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# Optional external Redis URL (leave empty to use built-in in-memory cache + async worker)
REDIS_URL=

# Security secrets
JWT_SECRET="linkora-local-dev-jwt-secret-min-32-chars"
IP_HASH_SALT="linkora-daily-ip-hash-salt"

# Optional Google OAuth 2.0 Client ID (required for "Continue with Google")
GOOGLE_CLIENT_ID=
