# Backend API base URL (Fastify server)
# Development: http://localhost:4000
# Production:  https://your-actual-domain.com
VITE_API_URL=http://localhost:4000

# Optional: Public short-link domain override if frontend and short-link backend differ
# Development: http://localhost:4000
# Production:  https://your-actual-domain.com
VITE_PUBLIC_BASE_URL=http://localhost:4000

# Optional: Google OAuth 2.0 Client ID for one-click "Continue with Google"
VITE_GOOGLE_CLIENT_ID=
